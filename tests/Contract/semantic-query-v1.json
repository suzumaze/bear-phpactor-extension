            "successDataKeys": ["route", "resource"]
        },
        "bear/sql/resolve": {
            "handler": "resolveSql",
            "parameters": [
                {"name": "queryId", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["queryId", "path"]
        },
        "bear/template/resolve": {
            "handler": "resolveTemplate",
            "parameters": [
                {"name": "engine", "type": "string", "required": true},
                {"name": "name", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["engine", "name", "path"]
        },
        "bear/template/forResource": {
            "handler": "resolveResourceTemplate",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "engine", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resource", "engine", "path", "searched"]
        },
        "bear/alps/resolveDescriptor": {
            "handler": "resolveAlpsDescriptor",
            "parameters": [
                {"name": "descriptorId", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["descriptorId", "profilePath", "byteOffset"]
        },
        "bear/alps/describeDescriptor": {
            "handler": "describeAlpsDescriptor",
            "parameters": [
                {"name": "descriptorId", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": [
                "descriptorId",
                "profilePath",
                "byteOffset",
                "type",
                "name",
                "rt",
                "href",
                "rel",
                "doc",
                "def",
                "tag",
                "title",
                "relationsOut",
                "relationsIn"
            ]
        },
        "bear/schema/resolveNamed": {
            "handler": "resolveNamedSchema",
            "parameters": [
                {"name": "fileName", "type": "string", "required": true},
                {"name": "kind", "type": "string", "required": true},
