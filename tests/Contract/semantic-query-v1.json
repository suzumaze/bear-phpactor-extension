        },
        "bear/schema/describeNamed": {
            "handler": "describeNamedSchema",
            "parameters": [
                {"name": "fileName", "type": "string", "required": true},
                {"name": "kind", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["kind", "source", "path", "titleByteOffset", "resource", "available", "types", "properties"]
        },
        "bear/schema/describeForResource": {
            "handler": "describeResourceSchema",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "kind", "type": "string", "required": false, "default": "response"},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["kind", "source", "path", "titleByteOffset", "resource", "available", "types", "properties"]
        }
    }
}
