{
    "semanticApiVersion": 1,
    "statuses": [
        "ok",
        "not_found",
        "ambiguous",
        "invalid_input",
        "unsupported",
        "parse_error",
        "engine_unavailable",
        "outside_workspace",
        "timeout"
    ],
    "failureEnvelopeKeys": [
        "status",
        "data",
        "candidates",
        "provenance",
        "error"
    ],
    "partialFailureEnvelopeKeys": [
        "status",
        "data",
        "candidates",
        "provenance",
        "partial",
        "error"
    ],
    "partialFailureDataKeys": [
        "resource",
        "engine",
        "path",
        "searched"
    ],
    "errorKeys": [
        "code",
        "message"
    ],
    "methods": {
        "bear/project/info": {
            "handler": "describeProject",
            "parameters": [
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": [
                "semanticApiVersion",
                "workspaceName",
                "projectPath",
                "composerPath",
                "psr4Roots",
                "excludedPsr4Roots",
                "resourceCount",
                "capabilities",
                "versions",
                "compatibilityIssues"
            ]
        },
        "bear/resource/resolve": {
            "handler": "resolveResource",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["uri", "fqn", "path"]
        },
        "bear/resource/list": {
            "handler": "listResources",
            "parameters": [
                {"name": "scheme", "type": "string|null", "required": false, "default": null},
                {"name": "prefix", "type": "string", "required": false, "default": ""},
                {"name": "limit", "type": "int", "required": false, "default": 50}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resources", "total", "truncated"]
        },
        "bear/resource/describe": {
            "handler": "describeResource",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null},
                {"name": "incomingLimit", "type": "int", "required": false, "default": 50}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resource", "methods", "relationsOut", "relationsIn", "templates", "schemas"]
        },
        "bear/resource/attributes": {
            "handler": "describeResourceAttributes",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resource", "attributes", "argumentPolicy"]
        },
        "bear/resource/attributeIndex": {
            "handler": "indexResourceAttributes",
            "parameters": [
                {"name": "scheme", "type": "string|null", "required": false, "default": null},
                {"name": "prefix", "type": "string", "required": false, "default": ""},
                {"name": "limit", "type": "int", "required": false, "default": 50}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["items", "total", "truncated", "argumentPolicy"]
        },
        "bear/resource/incomingRelations": {
            "handler": "findIncomingResourceRelations",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null},
                {"name": "limit", "type": "int", "required": false, "default": 50}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resource", "available", "items", "total", "truncated"]
        },
        "bear/resource/references": {
            "handler": "findResourceReferences",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null},
                {"name": "limit", "type": "int", "required": false, "default": 50}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resource", "references", "total", "truncated"]
        },
        "bear/contract/compare": {
            "handler": "compareContract",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "method", "type": "string", "required": false, "default": "onGet"},
                {"name": "schemaKind", "type": "string", "required": false, "default": "response"},
                {"name": "descriptorId", "type": "string|null", "required": false, "default": null},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["resource", "method", "schemaKind", "surfaces", "comparison"]
        },
        "bear/route/resolve": {
            "handler": "resolveRoute",
            "parameters": [
                {"name": "route", "type": "string", "required": true},
