            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
            "successDataKeys": ["kind", "source", "path", "titleByteOffset", "resource"]
        },
        "bear/schema/forResource": {
            "handler": "resolveResourceSchema",
            "parameters": [
                {"name": "uri", "type": "string", "required": true},
                {"name": "kind", "type": "string", "required": false, "default": "response"},
                {"name": "contextPath", "type": "string|null", "required": false, "default": null}
            ],
            "successEnvelopeKeys": ["status", "data", "candidates", "provenance"],
