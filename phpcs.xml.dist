<?xml version="1.0"?>
<ruleset name="suzumaze/bear-phpactor-extension">
    <description>PSR-12 coding standard for lib/ and tests/</description>

    <file>lib</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <!--
        LSPテストのカーソル位置マーカーを含むPHPフィクスチャと、PHP構文ではない
        Qiqテンプレートは意図的に検査対象外。
    -->
    <exclude-pattern>tests/Fixture/JsonSchema/basic/src/Resource/App/(BodyTypeDemo|NoSchema|User)\.php</exclude-pattern>
    <exclude-pattern>tests/Fixture/JsonSchema/basic/src/Resource/App/Cache/(ArticlePreview|ArticleList|ArticleTags|AuthorProfile|AuthorList|Orphan)\.php</exclude-pattern>
    <exclude-pattern>tests/Fixture/JsonSchema/basic/src/Resource/Page/Admin/UserProfile\.php</exclude-pattern>
    <exclude-pattern>tests/Fixture/Template/basic/var/qiq/template/.*\.php</exclude-pattern>
</ruleset>
